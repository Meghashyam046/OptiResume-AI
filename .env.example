# OPENAI_API_KEY: Securely stored in backend environment variables for ChatGPT analysis.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# GEMINI_API_KEY: Automatically provided by the platform once attached in Settings > Secrets.
GEMINI_API_KEY=""

# SUPABASE_URL & SUPABASE_ANON_KEY: Used as the cloud backend database.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
